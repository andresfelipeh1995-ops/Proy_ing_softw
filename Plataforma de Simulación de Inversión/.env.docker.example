# Copie este archivo como ".env" en la misma carpeta que docker-compose.yml
# y ajuste los valores antes de ejecutar "docker compose up -d --build".

# Puertos publicados en el equipo anfitrión
FRONTEND_PORT=5500
BACKEND_PORT=8082

# Base de datos PostgreSQL (servicio interno "db")
POSTGRES_DB=investsim
POSTGRES_USER=investsim
POSTGRES_PASSWORD=cambie-esta-clave
JPA_DDL_AUTO=update

# Seguridad y administrador inicial
JWT_SECRET=cambie-este-secreto-por-uno-de-mas-de-32-caracteres
JWT_EXPIRATION_HOURS=2
ADMIN_EMAIL=admin@investsim.co
ADMIN_PASSWORD=Admin123!
DEFAULT_INITIAL_BALANCE=100000

# Proveedores de mercado (opcionales)
ALPHA_VANTAGE_API_KEY=
TWELVE_DATA_API_KEY=
SYNTHETIC_MARKET_DATA_ENABLED=true
INGESTION_ENABLED=true
INGESTION_CRON=0 0 */6 * * *
INGESTION_HISTORY_DAYS=365
